#!/bin/bash
# Keep machine-specific measurements and project identifiers out of this public
# repository. Inspect only staged additions so existing history does not block
# unrelated commits.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
local_patterns="$repo_root/git/sensitive-patterns.local"
staged=$(mktemp)
trap 'rm -f "$staged"' EXIT

{
	git diff --cached --name-only --diff-filter=ACMR --
	# No `+++` header filter: it would also drop added lines starting with "++",
	# and the header only repeats a path already listed above.
	git diff --cached --unified=0 --no-color --diff-filter=ACMR -- \
		| sed -n 's/^+//p'
} >"$staged"

failures=()
if grep -Eiq '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' "$staged"; then
	failures+=("UUID-like session identifier")
fi
if grep -Eq '\$[0-9][0-9,]*\.[0-9]{2}([^0-9]|$)' "$staged"; then
	failures+=("dollar-denominated measurement")
fi
# Absolute home paths reveal the account name and break on other machines;
# configs here use ~ or $HOME. (The account name alone is not checked: public
# addresses such as the calendar IDs in global-instructions.md contain it.)
if grep -Fq -- "$HOME/" "$staged"; then
	failures+=("absolute home directory path ($HOME/...)")
fi
if [[ -s $local_patterns ]]; then
	while IFS= read -r pattern || [[ -n $pattern ]]; do
		[[ -z $pattern || $pattern == \#* ]] && continue
		if grep -Fiq -- "$pattern" "$staged"; then
			failures+=("machine-local pattern: $pattern")
		fi
	done <"$local_patterns"
fi

if ((${#failures[@]} > 0)); then
	printf 'pre-commit: refusing possibly machine-specific data in this public repository:\n' >&2
	printf '  - %s\n' "${failures[@]}" >&2
	printf 'Review the staged paths and added lines. If the content is intentionally public, commit with --no-verify.\n' >&2
	exit 1
fi

# A model pin change needs a model-migration-review cycle recorded in its
# journal. Warn-only: a revert or a journal-first commit is legitimate.
# ponytail: line regexes on the -U0 diff, not a config parser. The omp pattern
# is any two-space-indented `key: provider/model` line (modelRoles today).
pins=$(git diff --cached --unified=0 --no-color -- claude/settings.json codex/config.toml omp/config.yml |
	grep -E '^[+-](\s*"model"\s*:|model\s*=|  [a-z]+: [a-z][a-z0-9-]*/\S+$)' || true)
if [[ -n $pins ]] && ! git diff --cached --quiet -- agents/skills/model-migration-review/journal.md 2>/dev/null; then
	pins=
fi
if [[ -n $pins ]]; then
	printf 'pre-commit: model pin changed without a journal entry:\n%s\n' "$pins" >&2
	printf 'Run the model-migration-review skill and record the result in agents/skills/model-migration-review/journal.md.\n' >&2
fi

# This repo sets a local core.hooksPath, which bypasses the machine-global
# dispatcher. Hand off to it through its pre-commit symlink (the dispatcher
# keys on its own name) so a check added there runs here too, instead of
# keeping a second copy of the list that silently drifts.
exec "$repo_root/git/global-hooks/pre-commit" "$@"
