#!/bin/bash
# Machine-global pre-commit check: enforce this repo's long-form-only
# Compose Specification policy on staged Compose files, matching the
# edit-time check (scripts/compose-canonical-check). Runs alongside, not
# instead of, pre-commit-dclint (style) and pre-commit-compose-config
# (schema/merge validation). Short-form fields already in HEAD do not block
# (lib/baseline.bash); only ones the commit adds do.
set -euo pipefail

checker="$HOME/dotfiles/scripts/compose-canonical-check"
[[ -x $checker ]] || exit 0
command -v yq >/dev/null || exit 0

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
targets=()
while IFS= read -r -d '' file; do
	[[ -f $file ]] || continue
	case "${file##*/}" in
	compose*.yml | compose*.yaml | docker-compose*.yml | docker-compose*.yaml)
		targets+=("$file")
		;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
((${#targets[@]})) || exit 0

# Findings are lines `<file>: service <name> uses short-form <field> ...`;
# they carry no position, so the whole line is the key. Any other output (a
# parse failure, a missing yq or jq) is a tool failure whose output is shown.
canonical_rows() (
	rc=0
	out=$("$checker" "$@" 2>&1) || rc=$?
	((rc == 0)) && exit 0
	if ((rc == 1)) && rows=$(printf '%s\n' "$out" | awk '
		!NF { next }
		{ gsub(/[\t\r]+/, " ") }
		!match($0, /: service .+ uses short-form [a-z_]+ /) || RSTART == 1 { bad = 1; exit }
		{ printf "%s\t-\t-\t%s\t%s\n", substr($0, 1, RSTART - 1), $0, $0 }
		END { exit bad }'); then
		printf '%s\n' "$rows"
		exit 1
	fi
	printf '%s\n' "$out"
	exit 2
)

# shellcheck source-path=SCRIPTDIR source=../lib/baseline.bash
source "$(dirname "$(readlink -f "$0")")/../lib/baseline.bash"
if ! baseline_check canonical_rows "${targets[@]}"; then
	echo "pre-commit: short-form Compose syntax in staged files. Use the Compose Specification long (mapping) form, or commit with --no-verify." >&2
	exit 1
fi
