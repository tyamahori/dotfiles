#!/bin/bash
# Match the edit-time check so manual commits enforce the same policy.
# Findings already in HEAD do not block (lib/baseline.bash); needs jq to tell
# new from old, without it every finding blocks.
set -euo pipefail

command -v hadolint >/dev/null || exit 0
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
targets=()
while IFS= read -r -d '' file; do
	[[ -f $file ]] || continue
	case "${file##*/}" in
	Dockerfile | Dockerfile.* | *.Dockerfile) targets+=("$file") ;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
((${#targets[@]})) || exit 0

command -v jq >/dev/null || exec hadolint --failure-threshold style -- "${targets[@]}"

# Row: file, line, key (rule and message; the baseline adds the flagged line).
hadolint_rows() (
	rc=0
	out=$(hadolint --failure-threshold style -f json -- "$@" 2>&1) || rc=$?
	((rc == 0)) && exit 0
	if ((rc == 1)) && rows=$(jq -r '.[] | [.file, (.line | tostring), (.line | tostring), "\(.code) \(.message | gsub("[\t\r\n]+"; " "))", "\(.file):\(.line) \(.code) \(.message | gsub("[\t\r\n]+"; " "))"] | @tsv' <<<"$out" 2>/dev/null); then
		printf '%s\n' "$rows"
		exit 1
	fi
	printf '%s\n' "$out"
	exit 2
)

# shellcheck source-path=SCRIPTDIR source=../lib/baseline.bash
source "$(dirname "$(readlink -f "$0")")/../lib/baseline.bash"
# shellcheck disable=SC2034 # read by baseline_check in the sourced lib
BASELINE_EXTRA=(.hadolint.yaml .hadolint.yml)
baseline_check hadolint_rows "${targets[@]}"
