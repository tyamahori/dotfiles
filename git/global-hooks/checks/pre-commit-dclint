#!/bin/bash
# Machine-global pre-commit check: lint staged Docker Compose files with
# dclint so obsolete notation (version field, untagged images, unquoted
# ports) cannot be committed even when the edit-time hook was bypassed.
# Warnings also fail (--max-warnings 0), but only ones the commit adds:
# findings already in HEAD do not block (lib/baseline.bash). A repo's own
# .dclintrc wins; one commit escapes with --no-verify, a line opts out with
# `# dclint disable-line <rule>`.
set -euo pipefail

dclint="$HOME/dotfiles/tools/dclint/node_modules/.bin/dclint"
# dclint is a node script; GUI git clients often run without the devbox PATH.
[[ -x $dclint ]] && command -v node >/dev/null || exit 0

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
targets=()
while IFS= read -r -d '' file; do
	[[ -f $file ]] || continue
	case "${file##*/}" in
	compose*.yml | compose*.yaml | docker-compose*.yml | docker-compose*.yaml)
		targets+=("$file")
		;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
((${#targets[@]})) || exit 0

# Compact lines are `file:line:col message [rule]`. Only such lines are
# findings; anything else (invalid config, crash) is a tool failure whose log
# is shown, never compared. The first `:N:N ` splits the path, so paths with
# spaces work.
dclint_rows() (
	rc=0
	log=$("$dclint" --formatter compact --no-color --max-warnings 0 "$@" 2>&1) || rc=$?
	((rc == 0)) && exit 0
	if ((rc == 1)) && rows=$(printf '%s\n' "$log" | awk '
		!NF { next }
		{ gsub(/[\t\r]+/, " ") }
		!match($0, /:[0-9]+:[0-9]+ /) { bad = 1; exit }
		{
			split(substr($0, RSTART + 1, RLENGTH - 2), p, ":")
			printf "%s\t%s\t%s\t%s\t%s\n", substr($0, 1, RSTART - 1), p[1], p[1], substr($0, RSTART + RLENGTH), $0
		}
		END { exit bad }'); then
		printf '%s\n' "$rows"
		exit 1
	fi
	printf '%s\n' "$log"
	exit 2
)

# shellcheck source-path=SCRIPTDIR source=../lib/baseline.bash
source "$(dirname "$(readlink -f "$0")")/../lib/baseline.bash"
# shellcheck disable=SC2034 # read by baseline_check in the sourced lib
BASELINE_EXTRA=(.dclintrc .dclintrc.json .dclintrc.yaml .dclintrc.yml .dclintrc.js .dclintrc.cjs .dclintrc.mjs dclint.config.js dclint.config.cjs dclint.config.mjs)
if ! baseline_check dclint_rows "${targets[@]}"; then
	echo "pre-commit: dclint found Compose lint errors or warnings in staged files." >&2
	echo "Fix them (dclint --fix handles most), or commit with --no-verify." >&2
	exit 1
fi
