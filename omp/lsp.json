{
  "servers": {
    "gopls": {
      "rootMarkers": [
        "go.work",
        "go.mod",
        ".git"
      ]
    },
    "pyright": {
      "rootMarkers": [
        ".git",
        "pyproject.toml",
        "pyrightconfig.json",
        "setup.py",
        "setup.cfg",
        "requirements.txt",
        "Pipfile"
      ]
    },
    "tsc-lsp": {
      "args": [
        "--lsp",
        "--stdio"
      ],
      "command": "tsc",
      "fileTypes": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ],
      "rootMarkers": [
        ".git",
        "jsconfig.json",
        "package.json",
        "tsconfig.json"
      ]
    },
    "typescript-native": {
      "disabled": true
    }
  }
}
