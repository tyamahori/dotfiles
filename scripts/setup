#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"

# Each step runs as a child, so PATH set inside a step never reaches the later
# ones, and on a fresh machine .zprofile is not linked yet. Expose here the
# install locations later steps need: nix for devbox and init re-runs, the user
# bins where apps puts npm CLIs and omp (Linux) and uv puts python.
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/nix/var/nix/profiles/default/bin:$PATH"

"${SCRIPT_DIR}/init"
if [ -x /opt/homebrew/bin/brew ]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi
"${SCRIPT_DIR}/devbox"
eval "$(devbox global shellenv)"
"${SCRIPT_DIR}/apps"
"${SCRIPT_DIR}/python"
"${SCRIPT_DIR}/link"
"${SCRIPT_DIR}/agent-tools"
"${SCRIPT_DIR}/omp-plugins"

echo "Setup completed. Open a new shell to load environment changes."
