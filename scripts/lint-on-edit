#!/bin/bash
# Shared PostToolUse hook: lint a file right after an agent writes or edits
# (settings.json, Write|Edit matcher), Codex (codex/hooks/lint-edit.sh
# adapter), and OMP (omp/extensions/lint-on-edit.ts). zsh is skipped (shellcheck
# cannot parse it). Workflow files run both actionlint and zizmor. Clean files,
# non-target files, and files whose linter is not installed produce no output at
# all.
set -euo pipefail

# Reads Claude-style JSON ({tool_input:{file_path}}) on stdin and emits a
# {decision:"block"} JSON on findings. Consumers: Claude Code, Codex, and OMP.

file=$(jq -r '.tool_input.file_path // empty')
[ -n "$file" ] && [ -f "$file" ] || exit 0

linter=
extra_linter=
json_format=
case "$file" in
  */.github/workflows/*.yml|*/.github/workflows/*.yaml) linter=actionlint; extra_linter=zizmor ;;
  # dclint's own discovery pattern: (docker-)?compose*.ya?ml on the basename
  # (a `*/compose*` case pattern would also match a directory named compose).
  *.yml|*.yaml)
    case "${file##*/}" in
      compose*|docker-compose*) linter=dclint ;;
      Dockerfile.*) linter=hadolint ;;
      *) exit 0 ;;
    esac
    ;;
  Dockerfile|Dockerfile.*|*.Dockerfile|*/Dockerfile|*/Dockerfile.*) linter=hadolint ;;
  *.sql) linter=sqruff ;;
  # JSONC dialects (comments/trailing commas are legal there) — never jq them.
  *.jsonc|tsconfig*.json|*/tsconfig*.json|jsconfig*.json|*/jsconfig*.json|*/.vscode/*.json|devcontainer.json|*/devcontainer.json|*/.devcontainer/*.json) exit 0 ;;
  */claude/settings.json|*/.claude/settings.json|*/codex/hooks.json|*/.codex/hooks.json|*/omp/lsp.json|*/.omp/agent/lsp.json|*/omp/mcp.json|*/.omp/agent/mcp.json) linter=jq; json_format=canonical ;;
  *.json) linter=jq ;;
  *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) linter=oxlint ;;
  *.py) linter=ruff ;;
  *.sh|*.bash) linter=shellcheck ;;
  *.zsh) exit 0 ;;
  *)
    shebang=$(head -1 "$file")
    if printf '%s' "$shebang" | grep -Eq '^#!.*\b(ba)?sh\b'; then
      linter=shellcheck
    elif printf '%s' "$shebang" | grep -Eq '^#!.*\bpython'; then
      linter=ruff
    else
      exit 0
    fi
    ;;
esac

# dclint is a locked Node dependency (tools/dclint, installed by
# scripts/devbox), not a PATH binary.
dclint_bin="$HOME/dotfiles/tools/dclint/node_modules/.bin/dclint"
if [ "$linter" = dclint ]; then
  [ -x "$dclint_bin" ] || exit 0
elif ! command -v "$linter" >/dev/null; then
  linter=
fi
if [ -n "$extra_linter" ] && ! command -v "$extra_linter" >/dev/null; then
  extra_linter=
fi
[ -n "$linter$extra_linter" ] || exit 0

# Never fail the hook itself; findings go back via decision:block.
findings=
case "$linter" in
  # SC2016 ($ in single quotes) fires on intended jq/awk programs, and SC1091
  # (unfollowed source) is an environment note, not a defect in the edit; both
  # recurred across sessions with no fix to make.
  shellcheck) findings=$(shellcheck --format=gcc -e SC2016,SC1091 "$file" 2>&1 | head -c 4000) || true ;;
  jq)
    findings=$(jq empty "$file" 2>&1 | head -c 4000) || true
    if [ -z "$findings" ] && [ "$json_format" = canonical ]; then
      findings=$(diff -u "$file" <(jq --sort-keys . "$file") | head -c 4000) || true
      [ -z "$findings" ] || findings="agent config JSON must match jq --sort-keys output:
$findings"
    fi
    ;;
  ruff) findings=$(ruff check --no-cache --quiet --output-format concise "$file" 2>&1 | head -c 4000) || true ;;
  # Default categories only (correctness-centred, near-zero FP); a project's
  # own .oxlintrc.json is discovered and wins. Clean files print nothing.
  oxlint) findings=$(oxlint --format=unix "$file" 2>&1 | head -c 4000) || true ;;
  actionlint) findings=$(actionlint -no-color "$file" 2>&1 | head -c 4000) || true ;;
  hadolint) findings=$(hadolint --failure-threshold style --format tty "$file" 2>&1 | head -c 4000) || true ;;
  sqruff)
    out=$(sqruff lint "$file" 2>&1) && rc=0 || rc=$?
    [ "$rc" -eq 0 ] || findings=$(printf '%s' "$out" | head -c 4000) || true
    ;;
  # Also enforces this repo's long-form-only Compose Specification policy
  # (scripts/compose-canonical-check) alongside dclint's style rules.
  dclint)
    findings=$("$dclint_bin" --formatter compact --no-color --max-warnings 0 "$file" 2>&1) || true
    canonical=
    if command -v yq >/dev/null; then
      canonical=$("$HOME/dotfiles/scripts/compose-canonical-check" "$file" 2>&1) || true
    fi
    findings=$(printf '%s\n%s' "$findings" "$canonical" | sed '/^$/d' | head -c 4000) || true
    ;;
esac
if [ "$extra_linter" = zizmor ]; then
  # zizmor prints "No findings to report" even with --quiet; only a non-zero
  # exit means findings (or a parse error worth showing).
  if ! extra_findings=$(zizmor --quiet --offline "$file" 2>&1); then
    findings=$(printf '%s\n%s' "$findings" "$extra_findings" | sed '/^$/d' | head -c 4000) || true
  fi
fi
[ -n "$findings" ] || exit 0

jq -n --arg reason "${linter:-$extra_linter} found issues in the file you just edited — fix them now:
$findings" '{decision: "block", reason: $reason}'
