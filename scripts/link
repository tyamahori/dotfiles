#!/bin/bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DOTFILES_DIR="${REPO_ROOT}/dotfiles"
GIT_DIR="${REPO_ROOT}/git"
AGENTS_DIR="${REPO_ROOT}/agents"
CLAUDE_DIR="${REPO_ROOT}/claude"
OMP_DIR="${REPO_ROOT}/omp"

# dotfiles
for dotfile in "${DOTFILES_DIR}"/.??*; do
	if [[ $dotfile == "$DOTFILES_DIR/." || $dotfile == "$DOTFILES_DIR/.." ]]; then
		continue
	fi
	ln -fnsv "$dotfile" "$HOME"
done

# global gitignore
mkdir -p "$HOME/.config/git"
ln -snfv "${GIT_DIR}/ignore" "$HOME/.config/git/ignore"

# claude code global settings (machine-local overrides go to ~/.claude/settings.local.json, gitignored)
mkdir -p "$HOME/.claude"
ln -snfv "${CLAUDE_DIR}/settings.json" "$HOME/.claude/settings.json"


# personal skills, shared across LLM CLIs
for skill in "${AGENTS_DIR}/skills"/*/; do
	skill="${skill%/}"
	for skills_dir in "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.copilot/skills" "$HOME/.agents/skills"; do
		mkdir -p "$skills_dir"
		ln -snfv "$skill" "$skills_dir/$(basename "$skill")"
	done
done

# herdr's bundled agent skill (herdr 0.8.0+): generated from the installed
# binary so it always matches the running version. Unlike the OpenSkills
# vendor skills below, herdr is a machine-level tool relevant in any repo, so
# it IS linked globally. brewUpdate regenerates it after upgrades; this block
# covers fresh machines and manual re-links.
if command -v herdr >/dev/null 2>&1 && herdr --skill >/dev/null 2>&1; then
	mkdir -p "$HOME/.agents/skills/herdr"
	herdr --skill >"$HOME/.agents/skills/herdr/SKILL.md"
	echo "Generated $HOME/.agents/skills/herdr/SKILL.md from herdr --skill" >&2
	for skills_dir in "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.copilot/skills"; do
		mkdir -p "$skills_dir"
		ln -snfv "$HOME/.agents/skills/herdr" "$skills_dir/herdr"
	done
fi

# OpenSkills-installed vendor skills (Cloudflare et al.) are deliberately NOT
# linked globally: their descriptions sit in every session's context whether or
# not the work touches that vendor. Install them per project instead —
# `ln -s ~/.agents/skills/<name> <repo>/.claude/skills/<name>`.
#
# Machines linked before that decision still carry the old symlinks, and this
# script's whole point is that running it reproduces the intended state — so
# retire them here rather than by hand. Only links INTO the OpenSkills
# directory are removed: the personal-skill loop above runs first, so a
# same-named skill in this repo must survive.
retired_global_skills=(
	agents-sdk
	cloudflare
	cloudflare-email-service
	cloudflare-one
	cloudflare-one-migrations
	durable-objects
	sandbox-sdk
	turnstile-spin
	web-perf
	workers-best-practices
	wrangler
)
for skill_name in "${retired_global_skills[@]}"; do
	for skills_dir in "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.copilot/skills"; do
		target="$skills_dir/$skill_name"
		if [[ -L $target && "$(readlink "$target")" == "$HOME/.agents/skills/"* ]]; then
			rm "$target"
			echo "Retired global vendor skill: $target" >&2
		fi
	done
done

# global agent instructions, shared across LLM CLIs (Claude Code, Codex, Copilot)
for agent_target in \
	"$HOME/.claude/CLAUDE.md" \
	"$HOME/.codex/AGENTS.md" \
	"$HOME/.copilot/copilot-instructions.md"; do
	mkdir -p "$(dirname "$agent_target")"
	ln -snfv "${AGENTS_DIR}/global-instructions.md" "$agent_target"
done

# Codex approval-request and turn-completion notifications
mkdir -p "$HOME/.local/bin"
ln -snfv "${REPO_ROOT}/scripts/codex-notify" "$HOME/.local/bin/codex-notify"
mkdir -p "$HOME/.codex"
ln -snfv "${REPO_ROOT}/codex/hooks.json" "$HOME/.codex/hooks.json"

# ghostty config. macOS reads the Application Support path; on Linux ghostty
# is XDG-only, so the same file is linked to ~/.config/ghostty/config.
if [ "$(uname)" = Darwin ]; then
	GHOSTTY_CONFIG_DIR="$HOME/Library/Application Support/com.mitchellh.ghostty"
else
	GHOSTTY_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"
fi
mkdir -p "$GHOSTTY_CONFIG_DIR"
ln -snfv "${REPO_ROOT}/ghostty/config" "$GHOSTTY_CONFIG_DIR/config"

# ghostty desktop entry (Linux). On macOS the .app carries its own launcher,
# but on Linux ghostty comes from devbox, whose profile is not in the session's
# XDG_DATA_DIRS — so GNOME never sees the shipped .desktop or icons. Copy the
# entry into the user's own applications dir with Exec pointed at the devbox
# profile symlink: GUI launchers do not source .zprofile, so a bare `ghostty`
# would not resolve, while the profile path (unlike a /nix/store path) survives
# upgrades. D-Bus activation is turned off for the same search-path reason.
if [ "$(uname)" != Darwin ]; then
	DEVBOX_PROFILE="$HOME/.local/share/devbox/global/default/.devbox/nix/profile/default"
	GHOSTTY_DESKTOP="${DEVBOX_PROFILE}/share/applications/com.mitchellh.ghostty.desktop"
	if [ -r "$GHOSTTY_DESKTOP" ]; then
		# GL wrapper. devbox's ghostty renders through nixpkgs' mesa, which
		# cannot load this host's DRI drivers — GTK dies with "Failed to create
		# EGL display" and no window ever appears. Putting the distro's library
		# directory ahead on LD_LIBRARY_PATH hands ghostty the host mesa that
		# does know the GPU. nixGL is the tidier fix, but it needs an impure
		# flake and re-derivation on every driver bump; this is one line and is
		# scoped to the ghostty process rather than the whole session.
		# ~/.local/bin precedes the devbox profile in both .zprofile and
		# .bash_profile, so shell invocations pick up the wrapper too.
		mkdir -p "$HOME/.local/bin"
		cat >"$HOME/.local/bin/ghostty" <<WRAPPER
#!/bin/sh
# Generated by dotfiles/scripts/link — edit there, not here.
LD_LIBRARY_PATH="/usr/lib/\$(uname -m)-linux-gnu\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "${DEVBOX_PROFILE}/bin/ghostty" "\$@"
WRAPPER
		chmod +x "$HOME/.local/bin/ghostty"
		echo "Generated $HOME/.local/bin/ghostty (host GL wrapper)" >&2

		mkdir -p "$HOME/.local/share/applications"
		sed -e "s|^TryExec=ghostty|TryExec=$HOME/.local/bin/ghostty|" \
			-e "s|^Exec=ghostty|Exec=$HOME/.local/bin/ghostty|" \
			-e "s|^DBusActivatable=true|DBusActivatable=false|" \
			"$GHOSTTY_DESKTOP" \
			>"$HOME/.local/share/applications/com.mitchellh.ghostty.desktop"
		echo "Installed $HOME/.local/share/applications/com.mitchellh.ghostty.desktop" >&2

		find -L "${DEVBOX_PROFILE}/share/icons/hicolor" -name 'com.mitchellh.ghostty.png' |
			while read -r icon; do
				rel="${icon#"${DEVBOX_PROFILE}"/share/icons/hicolor/}"
				mkdir -p "$HOME/.local/share/icons/hicolor/$(dirname "$rel")"
				ln -snf "$icon" "$HOME/.local/share/icons/hicolor/$rel"
			done

		update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
		gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
	fi
fi

# herdr config (session state and logs stay unmanaged in ~/.config/herdr)
mkdir -p "$HOME/.config/herdr"
ln -snfv "${REPO_ROOT}/herdr/config.toml" "$HOME/.config/herdr/config.toml"

# OMP (Oh My Pi) agent config. Only user-authored files are managed; state
# (agent.db with credentials, sessions, history, logs) stays unmanaged in
# ~/.omp. Legacy ~/.pi is not linked: OMP does not read ~/.pi/agent/extensions.
mkdir -p "$HOME/.omp/agent"
ln -snfv "${OMP_DIR}/config.yml" "$HOME/.omp/agent/config.yml"
ln -snfv "${OMP_DIR}/APPEND_SYSTEM.md" "$HOME/.omp/agent/APPEND_SYSTEM.md"
ln -snfv "${OMP_DIR}/extensions" "$HOME/.omp/agent/extensions"
ln -snfv "${OMP_DIR}/mcp.json" "$HOME/.omp/agent/mcp.json"

# launchd agents: link, then (re)load so schedule edits take effect.
# macOS-only — there is no launchd on Linux and the scheduled job
# (python-skill-review) has no systemd equivalent in this repo yet.
if [ "$(uname)" = Darwin ]; then
	mkdir -p "$HOME/Library/LaunchAgents"
	for plist in "${REPO_ROOT}/launchd"/*.plist; do
		target="$HOME/Library/LaunchAgents/$(basename "$plist")"
		ln -snfv "$plist" "$target"
		launchctl bootout "gui/$(id -u)" "$target" 2>/dev/null || true
		launchctl bootstrap "gui/$(id -u)" "$target"
	done
else
	echo "link: skipping launchd agents (macOS only)" >&2
fi
