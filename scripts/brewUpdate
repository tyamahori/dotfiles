#!/bin/bash

# Homebrew upgrades replace a tool's Cellar path while existing sessions keep
# spawning through the old absolute path (measured 2026-08-27: two hub starts
# failed after omp 18.0.3 was removed). Keep automatic cleanup disabled during
# the upgrade, then clean only when tool-restart finds no running process on
# an old keg.

# Later steps still run after a failed update (a partial upgrade still needs
# its release review), but the first failure's status becomes the exit status.
status=0

# Homebrew is macOS-only here; on Linux the herdr skill refresh below is still
# worth running, so skip just the brew half.
if [ "$(uname)" = Darwin ]; then
	if HOMEBREW_NO_INSTALL_CLEANUP=1 brew update &&
		HOMEBREW_NO_INSTALL_CLEANUP=1 brew upgrade &&
		HOMEBREW_NO_INSTALL_CLEANUP=1 brew upgrade --cask --greedy; then
		# Nonzero also covers "could not inspect": cleanup is the part that can wait.
		if "$(dirname "$0")/tool-restart" --cleanup-check; then
			brew cleanup
		else
			echo "brewUpdate: skipping brew cleanup; old or unknown tool executables may still be running" >&2
			echo "brewUpdate: restart them (tool-restart --apply), then run scripts/brewUpdate again" >&2
		fi
	else
		status=$?
		echo "brewUpdate: brew update/upgrade failed (exit $status); skipped brew cleanup" >&2
	fi
	# upgrade never reconciles against the Brewfile; surface drift here.
	brew bundle check --file "$HOME/.Brewfile" >/dev/null ||
		echo "brewUpdate: ~/.Brewfile is not satisfied; see brew bundle check --verbose" >&2
else
	echo "brewUpdate: skipping brew (macOS only)" >&2
	# Linux OMP is the upstream binary (scripts/apps), which brew never sees.
	if [ -x "$HOME/.local/bin/omp" ]; then
		"$HOME/.local/bin/omp" update || {
			status=$?
			echo "brewUpdate: omp update failed (exit $status)" >&2
		}
	fi
fi

# Hook state no session reads again: prose-review baselines of sessions that
# ended without a stop (scripts/japanese-prose-hook-*) and fail-fast counters
# (scripts/fail-fast-hook). Nothing else removes them, and leftovers keep the
# stop hook's "nothing recorded" exit from firing.
hook_cache=${XDG_CACHE_HOME:-$HOME/.cache}
if [ -d "$hook_cache/agent-japanese-prose" ]; then
	find "$hook_cache/agent-japanese-prose" -mindepth 2 -maxdepth 2 -type d -mtime +7 -exec rm -rf {} +
fi
if [ -d "$hook_cache/agent-fail-fast" ]; then
	find "$hook_cache/agent-fail-fast" -maxdepth 1 -type f -name '*.count' -mtime +7 -delete
fi

# herdr upgrades ship a new bundled agent skill; keep the local copy in sync
if command -v herdr >/dev/null 2>&1 && herdr --skill >/dev/null 2>&1; then
	mkdir -p "$HOME/.agents/skills/herdr"
	herdr --skill >"$HOME/.agents/skills/herdr/SKILL.md"
	echo "Regenerated ~/.agents/skills/herdr/SKILL.md from herdr --skill" >&2
fi

# Vendored third-party skills (agents/skills/*/.openskills.json) are not
# covered by `npx skills check`; report upstream drift here so it surfaces
# during the routine update pass. Applying is deliberate: scripts/skill-sync --apply.
"$(dirname "$0")/skill-sync" --check || true

# herdr / omp / Claude Code / Codex: when an installed version moved past the
# last reviewed one, write a report-only review of the changelog against this
# repo's config and notify. Applying is deliberate: tool-release-review --apply.
"$(dirname "$0")/tool-release-review" || echo "brewUpdate: tool-release-review failed" >&2

if [ -x "$HOME/.bun/bin/bun" ]; then
	"$HOME/.bun/bin/bun" upgrade || {
		bun_status=$?
		[ "$status" -ne 0 ] || status=$bun_status
	}
fi

"$(dirname "$0")/python" || {
	python_status=$?
	[ "$status" -ne 0 ] || status=$python_status
}
exit "$status"
