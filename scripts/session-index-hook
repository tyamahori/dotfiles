#!/bin/bash
# SessionStart hook (Claude/Codex): append one line per session start to a
# local index of where each session's transcript lives. The index sits under
# ~/.local/state, outside the repository, so it never reaches the public repo.
# Fields are the hook payload's identifiers and paths only: no prompt text,
# no cost, no token counts. OMP writes the same record shape from
# omp/extensions/session-index.ts.
# Usage: session-index-hook <agent>   (agent: claude | codex)
# Never blocks the session: any failure exits 0.
set -uo pipefail

agent=${1:?usage: session-index-hook <claude|codex>}
payload=$(cat)
session_id=$(jq -r '.session_id // empty' <<<"$payload" 2>/dev/null) || exit 0
[ -n "$session_id" ] || exit 0

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/agent-sessions
mkdir -p "$state_dir" || exit 0

jq -c --arg agent "$agent" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
	'{ts: $ts, agent: $agent, session_id: .session_id,
	  source: (.source // null), cwd: (.cwd // null),
	  transcript_path: (.transcript_path // null)}' \
	<<<"$payload" >>"$state_dir/sessions.jsonl" 2>/dev/null || exit 0
exit 0
