#!/bin/bash
# Shared PostToolUse/PostToolUseFailure hook (Bash matcher): when an
# SSH-backed git/ssh command fails with the locked-1Password signature, feed
# the one correct fix back instead of letting the agent misdiagnose it as a
# network or auth-config problem (measured misdiagnoses started rewriting
# remotes and SSH config; this hook replaced the always-loaded rule). Wired
# for Claude Code and Codex (Bash matcher). OMP does not call this script:
# omp/extensions/ssh-agent-hint.ts reimplements the same match in-process, so
# change the signature, the command match, or the advice in both places.
set -euo pipefail

payload=$(cat)
# Quoted text becomes one placeholder word: `printf 'x; git push origin'` is
# one command, while `git -C 'a b' push` keeps -C's value as a single word.
cmd=$(jq -r '.tool_input.command // empty | gsub("\u0027[^\u0027]*\u0027"; "Q") | gsub("\"(?:[^\"\\\\]|\\\\.)*\""; "Q")' <<<"$payload")
# Only commands that reach the SSH agent, in command position. Any git
# command was too wide: Codex's PostToolUse carries no exit status, so
# `git show` of a file quoting the signature (this repo's own docs) blocked
# with a false lock diagnosis. A here-string, not a pipe: grep -q exits at the
# first match, and printf writing a long command into the closed pipe fails
# the pipeline under pipefail.
grep -Eq '(^|[;&|(])[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*(ssh|scp|sftp|git([[:space:]]+(-[Cc][[:space:]]+[^[:space:]]+|-[^[:space:]]+))*[[:space:]]+(push|pull|fetch|clone|ls-remote|remote[[:space:]]+(update|show|prune)|submodule[[:space:]]+update))([[:space:]]|$)' <<<"$cmd" || exit 0

out=$(jq -r '[.tool_response // empty, .error // empty] | tostring' <<<"$payload" 2>/dev/null) || exit 0
printf '%s' "$out" | grep -qi 'communication with agent failed' || exit 0

jq -n '{decision: "block", reason: "This failure means the 1Password SSH agent is locked - nothing more. It is NOT a network, remote, or SSH-config problem: do not rewrite remotes, SSH config, or switch protocols. Ask the user to unlock 1Password (GUI approval), then retry the same command once. If it fails again with the same error, stop and report per the fail-fast rule."}'
