#!/bin/bash

# Disk usage report on the Desktop. The scanned root differs per OS: macOS
# hides the real data volume behind /System/Volumes/Data, Linux just uses /
# (-x keeps it on one filesystem either way).
if [ "$(uname)" = Darwin ]; then
	root=/System/Volumes/Data
else
	root=/
fi

# Authenticate first: a failed sudo would otherwise truncate the last reports.
# Headless Linux has no ~/Desktop.
sudo -v || exit 1
mkdir -p ~/Desktop
sudo du --si -xct 1000000000 "$root" | tee >(grep -vFe $'*\t' > ~/Desktop/DiskSpace.txt) | sort -hr > ~/Desktop/SortedDiskSpace.txt
