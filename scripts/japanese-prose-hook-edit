#!/bin/bash
# Shared command hook: capture the first lint result for each prose file before
# an edit, then record the file after a successful edit.
set -euo pipefail

payload=$(cat)
# The extension gate comes first: this runs before and after every edit, most
# edits are not prose, and each field read below is a jq process.
file=$(jq -r '.tool_input.file_path // empty' <<<"$payload")
case "$file" in
  *.md|*.markdown|*.txt) ;;
  *) exit 0 ;;
esac
event=$(jq -r '.hook_event_name // empty' <<<"$payload")
session_id=$(jq -r '.session_id // empty' <<<"$payload")
cwd=$(jq -r '.cwd // "."' <<<"$payload")
runtime=${JAPANESE_PROSE_RUNTIME:-claude}
case "$runtime" in
  ""|*[!A-Za-z0-9._-]*) exit 0 ;;
esac

[ -n "$session_id" ] || exit 0
case "$file" in
  /*) ;;
  *) file="$cwd/$file" ;;
esac

cache_base=${XDG_CACHE_HOME:-$HOME/.cache}
# shasum is a Perl script (~20 ms to start); sha256sum prints the same digest.
sha256=(sha256sum)
command -v sha256sum >/dev/null 2>&1 || sha256=(shasum -a 256)
session_key=$(printf '%s' "$session_id" | "${sha256[@]}")
session_key=${session_key%% *}
file_key=$(printf '%s' "$file" | "${sha256[@]}")
file_key=${file_key%% *}
cache_dir="$cache_base/agent-japanese-prose/$runtime/$session_key"
baseline_dir="$cache_dir/baselines"
files_dir="$cache_dir/files"
baseline="$baseline_dir/$file_key.json"

mkdir -p "$baseline_dir" "$files_dir"

case "$event" in
  PreToolUse)
    [ ! -f "$baseline" ] || exit 0

    lock="$baseline_dir/$file_key.lock"
    mkdir "$lock" 2>/dev/null || exit 0
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT

    tmp="$baseline.tmp.$$"
    if [ -f "$file" ]; then
      if ! "$HOME/dotfiles/scripts/japanese-prose-lint" "$file" >"$tmp"; then
        jq -n --arg file "$file" '{schemaVersion: 1, file: $file, findings: []}' >"$tmp"
      fi
    else
      jq -n --arg file "$file" '{schemaVersion: 1, file: $file, findings: []}' >"$tmp"
    fi
    mv "$tmp" "$baseline"
    ;;

  PostToolUse)
    printf '%s\n' "$file" >"$files_dir/$file_key"
    ;;
esac
