#!/bin/bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

message=""
while getopts ":m:" opt; do
	case "$opt" in
		m) message="$OPTARG" ;;
		*) echo "usage: sync [-m message]" >&2; exit 1 ;;
	esac
done

# git diff --cached --quiet: 0 = no staged changes, 1 = staged changes, else error.
has_staged_changes() {
	set +e
	git -C "$REPO_ROOT" diff --cached --quiet "$@"
	local status=$?
	set -e
	case "$status" in
		0) return 1 ;;
		1) return 0 ;;
		*) echo "git diff --cached failed (exit $status)" >&2; exit "$status" ;;
	esac
}

if ! git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
	echo "no upstream configured for the current branch — set one with 'git branch --set-upstream-to=<remote>/<branch>'" >&2
	exit 1
fi

git -C "$REPO_ROOT" status --short --branch

if [[ -n "$(git -C "$REPO_ROOT" ls-files -u)" ]]; then
	echo "unmerged paths in the index — resolve conflicts before syncing" >&2
	exit 1
fi

if has_staged_changes --no-renames -- docs/ops; then
	echo "docs/ops changes are staged — unstage the journal before syncing (git restore --staged docs/ops)" >&2
	exit 1
fi

branch="$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD)"
remote="$(git -C "$REPO_ROOT" config "branch.${branch}.remote")"
git -C "$REPO_ROOT" fetch "$remote"

read -r behind ahead <<<"$(git -C "$REPO_ROOT" rev-list --left-right --count '@{upstream}...HEAD')"

if (( behind > 0 )); then
	if ! git -C "$REPO_ROOT" pull --ff-only --no-rebase --no-autostash; then
		echo "fast-forward pull failed — resolve manually in $REPO_ROOT, then re-run sync" >&2
		exit 1
	fi
fi

if has_staged_changes; then
	if [[ -n "$message" ]]; then
		git -C "$REPO_ROOT" commit -m "$message"
	else
		git -C "$REPO_ROOT" commit -v
	fi
fi

read -r behind ahead <<<"$(git -C "$REPO_ROOT" rev-list --left-right --count '@{upstream}...HEAD')"
if (( ahead > 0 )); then
	git -C "$REPO_ROOT" push
fi

git -C "$REPO_ROOT" status --short --branch
porcelain="$(git -C "$REPO_ROOT" status --porcelain)"
read -r behind ahead <<<"$(git -C "$REPO_ROOT" rev-list --left-right --count '@{upstream}...HEAD')"
if [[ -z "$porcelain" && "$behind" -eq 0 && "$ahead" -eq 0 ]]; then
	echo "already in sync"
elif [[ -n "$porcelain" ]]; then
	echo "unstaged or untracked changes remain; not included in this sync" >&2
fi
