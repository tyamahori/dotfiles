#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Claude Code と omp のトークン使用量をプロジェクト単位で集計する(会話本文は出力しない)。

usage: agent-usage [--days N] [--project PATH | --all] [--by-session]

既定はカレントディレクトリのプロジェクト。--all で全プロジェクト横断。
omp 側はコンパクション回数と、コンパクション起因の再キャッシュ費用
(cacheWrite>50k の応答の合計コスト)を出し、費用の25%を超えたら
セッション交代を推奨する警告を出す。--notify は集計結果を macOS 通知にも
出す(launchd/com.tyamahori.agent-usage-weekly.plist が週次で使う)。
"""

import argparse
import json
import subprocess
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

CLAUDE_ROOT = Path.home() / ".claude/projects"
OMP_ROOT = Path.home() / ".omp/agent/sessions"
ACTIVE_WINDOW = timedelta(minutes=15)
CHURN_WARN = 0.25  # 8/16のchurn 50%事件後、14%まで改善した実測に合わせ早期警戒線へ


def claude_dirs(project: Path | None) -> list[Path]:
    if project is None:
        return sorted(p for p in CLAUDE_ROOT.iterdir() if p.is_dir()) if CLAUDE_ROOT.is_dir() else []
    # Claude Code は絶対パスの / (と一部の記号) を - に置換する
    for candidate in (
        str(project).replace("/", "-"),
        str(project).replace("/", "-").replace(".", "-"),
    ):
        path = CLAUDE_ROOT / candidate
        if path.is_dir():
            return [path]
    return []


def omp_dirs(project: Path | None) -> list[Path]:
    if project is None:
        return sorted(p for p in OMP_ROOT.iterdir() if p.is_dir()) if OMP_ROOT.is_dir() else []
    # omp は $HOME からの相対パスの / を - に置換し、先頭に - を付ける($HOME 自体は "-")
    home = Path.home()
    if project == home:
        name = "-"
    elif project.is_relative_to(home):
        name = "-" + str(project.relative_to(home)).replace("/", "-")
    else:
        name = str(project).replace("/", "-")
    path = OMP_ROOT / name
    return [path] if path.is_dir() else []


def parse_ts(record: dict) -> datetime | None:
    timestamp = record.get("timestamp")
    if not timestamp:
        return None
    try:
        return datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
    except ValueError:
        return None


def scan_claude(dirs: list[Path], cutoff: datetime) -> dict:
    """Claude Code のログを集計する。

    同一API応答が複数行へ分割され、さらに継続セッションへ履歴ごとコピーされるため
    usage が重複する。message.id で1応答1回に畳み、最古の timestamp の側へ計上する。
    """
    responses: dict[str, dict] = {}
    anonymous: list[dict] = []
    sessions: set[str] = set()

    for log_dir in dirs:
        for path in log_dir.glob("*.jsonl"):
            if path.stat().st_mtime < cutoff.timestamp():
                continue
            with path.open() as stream:
                for line in stream:
                    if '"usage"' not in line:
                        continue
                    try:
                        record = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    observed = parse_ts(record)
                    if observed is None or observed < cutoff:
                        continue
                    message = record.get("message") or {}
                    usage = message.get("usage")
                    if record.get("type") != "assistant" or not usage:
                        continue
                    session_id = record.get("sessionId")
                    if session_id:
                        sessions.add(session_id)
                    entry = {
                        "at": observed,
                        "session": session_id or "(unknown)",
                        "model": message.get("model") or "unknown",
                        "cache": usage.get("cache_read_input_tokens") or 0,
                        "create": usage.get("cache_creation_input_tokens") or 0,
                        "output": usage.get("output_tokens") or 0,
                    }
                    message_id = message.get("id")
                    if not message_id:
                        anonymous.append(entry)
                    elif message_id not in responses or observed < responses[message_id]["at"]:
                        responses[message_id] = entry

    models = defaultdict(lambda: {"calls": 0, "cache": 0, "create": 0, "output": 0})
    per_session = defaultdict(lambda: {"calls": 0, "cache": 0, "output": 0, "last": None})
    for entry in list(responses.values()) + anonymous:
        row = models[entry["model"]]
        row["calls"] += 1
        row["cache"] += entry["cache"]
        row["create"] += entry["create"]
        row["output"] += entry["output"]
        seat = per_session[entry["session"]]
        seat["calls"] += 1
        seat["cache"] += entry["cache"]
        seat["output"] += entry["output"]
        if seat["last"] is None or entry["at"] > seat["last"]:
            seat["last"] = entry["at"]
    return {"models": models, "sessions": sessions, "per_session": per_session}


def scan_omp(dirs: list[Path], cutoff: datetime) -> dict:
    """omp のセッションログ(1ファイル=1セッション)を集計する。

    レコード形式は .message.usage = {input, output, cacheRead, cacheWrite, cost:{total}}。
    継続セッションへの履歴コピーに備え、レコード id で1応答1回に畳む。
    """
    models = defaultdict(lambda: {"calls": 0, "cacheRead": 0, "cacheWrite": 0, "output": 0, "cost": 0.0})
    per_project = defaultdict(float)
    seen_ids: set[str] = set()
    sessions = 0
    compactions = 0
    churn_cost = 0.0  # cacheWrite>50kの応答=コンパクション直後の全文脈書き直し

    for log_dir in dirs:
        for path in log_dir.glob("*.jsonl"):
            if path.stat().st_mtime < cutoff.timestamp():
                continue
            session_counted = False
            with path.open() as stream:
                for line in stream:
                    if '"usage"' not in line and '"compaction"' not in line:
                        continue
                    try:
                        record = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    observed = parse_ts(record)
                    if observed is None or observed < cutoff:
                        continue
                    if record.get("type") == "compaction":
                        compactions += 1
                        continue
                    message = record.get("message") or {}
                    usage = message.get("usage")
                    if not usage:
                        continue
                    record_id = record.get("id")
                    if record_id:
                        if record_id in seen_ids:
                            continue
                        seen_ids.add(record_id)
                    if not session_counted:
                        sessions += 1
                        session_counted = True
                    row = models[message.get("model") or "unknown"]
                    row["calls"] += 1
                    row["cacheRead"] += usage.get("cacheRead") or 0
                    row["cacheWrite"] += usage.get("cacheWrite") or 0
                    row["output"] += usage.get("output") or 0
                    cost = (usage.get("cost") or {}).get("total") or 0.0
                    row["cost"] += cost
                    per_project[log_dir.name] += cost
                    if (usage.get("cacheWrite") or 0) > 50_000:
                        churn_cost += cost
    return {
        "models": models,
        "sessions": sessions,
        "compactions": compactions,
        "churn_cost": churn_cost,
        "per_project": per_project,
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--days", type=int, default=1)
    parser.add_argument("--project", type=Path, default=Path.cwd(), help="対象プロジェクトのパス(既定: cwd)")
    parser.add_argument("--all", action="store_true", help="全プロジェクトを横断集計する")
    parser.add_argument("--by-session", action="store_true", help="Claude Code のセッション別内訳も出す")
    parser.add_argument("--top", type=int, default=5, help="内訳の表示件数")
    parser.add_argument("--notify", action="store_true", help="集計結果を macOS 通知に出す(launchd 用)")
    args = parser.parse_args()

    project = None if args.all else args.project.resolve()
    now = datetime.now(timezone.utc)
    cutoff = now - timedelta(days=args.days)
    scope = "全プロジェクト" if args.all else str(project)
    print(f"対象: {scope} / 過去{args.days}日")

    claude = scan_claude(claude_dirs(project), cutoff)
    if claude["models"]:
        print(f"\nClaude Code: セッション {len(claude['sessions'])}")
        print("model\tcalls\tcache_read\tcache_create\toutput")
        for model, row in sorted(claude["models"].items(), key=lambda kv: kv[1]["cache"], reverse=True):
            print(f"{model}\t{row['calls']}\t{row['cache']}\t{row['create']}\t{row['output']}")

    omp = scan_omp(omp_dirs(project), cutoff)
    if omp["models"]:
        print(f"\nomp: セッション {omp['sessions']} / コンパクション {omp['compactions']}回")
        print("model\tcalls\tcache_read\tcache_write\toutput\tcost($)")
        total_cost = 0.0
        for model, row in sorted(omp["models"].items(), key=lambda kv: kv[1]["cost"], reverse=True):
            total_cost += row["cost"]
            print(
                f"{model}\t{row['calls']}\t{row['cacheRead']}\t{row['cacheWrite']}"
                f"\t{row['output']}\t{row['cost']:.2f}"
            )
        if total_cost > 0 and omp["churn_cost"] / total_cost > CHURN_WARN:
            print(
                f"警告: コンパクション起因の再キャッシュが ${omp['churn_cost']:.2f}"
                f" ({omp['churn_cost'] / total_cost:.0%}) — セッション交代を推奨"
            )
        if args.notify:
            churn = omp["churn_cost"] / total_cost if total_cost else 0.0
            body = (
                f"omp 過去{args.days}日: ${total_cost:.2f} / "
                f"compaction {omp['compactions']}回 / churn {churn:.0%}"
            )
            if churn > CHURN_WARN:
                body = "警告: セッション交代を推奨 — " + body
            subprocess.run(
                [
                    "osascript",
                    "-e",
                    f"display notification {json.dumps(body, ensure_ascii=False)}"
                    f" with title {json.dumps('agent-usage 週次', ensure_ascii=False)}",
                ],
                check=False,
            )
        if args.all and len(omp["per_project"]) > 1:
            print("\nproject\tcost($)")
            ranked = sorted(omp["per_project"].items(), key=lambda kv: kv[1], reverse=True)
            for name, cost in ranked[: args.top]:
                print(f"{name}\t{cost:.2f}")
            if len(ranked) > args.top:
                print(f"(他{len(ranked) - args.top}プロジェクト: ${sum(c for _, c in ranked[args.top:]):.2f})")

    if not claude["models"] and not omp["models"]:
        print("対象期間にログがありません")
        return

    if args.by_session and claude["per_session"]:
        ranked = sorted(claude["per_session"].items(), key=lambda kv: kv[1]["cache"], reverse=True)
        print("\nsession\tcalls\tcache_read\toutput\tlast\tstate")
        for session_id, seat in ranked[: args.top]:
            last = seat["last"]
            stamp = last.astimezone().strftime("%m-%d %H:%M") if last else "-"
            state = "active" if last and now - last <= ACTIVE_WINDOW else "idle"
            print(f"{session_id[:8]}\t{seat['calls']}\t{seat['cache']}\t{seat['output']}\t{stamp}\t{state}")


if __name__ == "__main__":
    main()
