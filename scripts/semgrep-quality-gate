#!/bin/bash
set -euo pipefail

fail() {
	echo "semgrep-quality-gate: $*" >&2
	exit 1
}

project_root=$(git rev-parse --show-toplevel 2>/dev/null) ||
	fail "run this command inside a Git repository"

# Repo-local rules take precedence; without them the machine-global default
# ruleset (dotfiles semgrep/default.yaml) still runs, so every repository
# gets the universal checks with zero per-repo setup. A repo opts out of
# even those by committing a .semgrep.yaml with `rules: []`. The Compose
# security rules (semgrep/security-compose.yaml) run in addition either way.
DOTFILES_ROOT=${DOTFILES_ROOT:-"$HOME/dotfiles"}
config="$project_root/.semgrep.yaml"
if [[ ! -f $config ]]; then
	config="$DOTFILES_ROOT/semgrep/default.yaml"
	if [[ ! -f $config ]]; then
		echo "semgrep-quality-gate: skipped; no .semgrep.yaml and no $config"
		exit 0
	fi
fi

command -v semgrep >/dev/null 2>&1 ||
	fail "semgrep is required; run ~/dotfiles/scripts/devbox"

cd "$project_root"
# --metrics=off keeps the scan fully local, which restricts --config to local
# rule files: registry packs (p/...) refuse to load without metrics, so repos
# vendor them into .semgrep.yaml instead (see docs/semgrep.md).
# --disable-version-check: the version is pinned (devbox flake lock, CI), and
# the check otherwise contacts semgrep.dev from a scan meant to stay local.
# The rules file excludes itself because generic-language patterns would
# otherwise match their own source text.
# Output is captured and shown only on failure: success costs one line of
# agent context instead of ~27, and unlike --quiet (which also swallows
# rule-file parse errors) the failure path keeps the full diagnosis.
# The PyPI semgrep-core segfaults under Ubuntu's 8 MiB default stack on
# aarch64-linux; macOS caps the hard limit, so a refusal there is harmless.
ulimit -s unlimited 2>/dev/null || true
log=$(mktemp)
trap 'rm -f "$log"' EXIT
if semgrep scan \
	--config "$config" \
	--config "$DOTFILES_ROOT/semgrep/security-compose.yaml" \
	--exclude .semgrep.yaml \
	--metrics=off \
	--disable-version-check \
	--error >"$log" 2>&1; then
	echo "semgrep-quality-gate: passed ($config)"
else
	cat "$log" >&2
	exit 1
fi
