#!/bin/bash
# Opt-in, not part of scripts/setup: let sudo (e.g. cask installs during
# scripts/brewUpdate) accept Touch ID. sudo_local survives macOS updates, unlike
# edits to /etc/pam.d/sudo. pam_reattach (from ~/.Brewfile) makes the prompt
# appear inside tmux/herdr. OpenPAM refuses to start when a listed module file
# is missing, even an `optional` one ("unable to initialize PAM"), which locks
# out sudo entirely, so refuse to write sudo_local until the module exists.
# Undo with `sudo rm /etc/pam.d/sudo_local`.
set -euo pipefail

reattach=/opt/homebrew/lib/pam/pam_reattach.so
if [[ ! -f "$reattach" ]]; then
  echo "touchid-sudo: $reattach missing; run brew bundle --file ~/.Brewfile first" >&2
  exit 1
fi

sudo tee /etc/pam.d/sudo_local >/dev/null <<EOF
auth       optional       $reattach ignore_ssh
auth       sufficient     pam_tid.so
EOF
