#!/bin/bash
set -euo pipefail

OS="$(uname)"
case "$OS" in
Darwin | Linux) ;;
*)
	echo "Unsupported OS: $OS (macOS and Linux only)" >&2
	exit 1
	;;
esac

if [ "$OS" = Darwin ]; then
	# Disable spotlight
	sudo mdutil -a -i off
	sudo chmod 0 /System/Library/CoreServices/Search.bundle/Contents/MacOS/Search

	# Homebrew
	if ! command -v brew >/dev/null 2>&1; then
		/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	fi
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Nix (Determinate Systems installer). The Linux installer needs the planner
# named explicitly and never prompts, so it can run unattended like the macOS one.
if ! command -v nix >/dev/null 2>&1; then
	if [ "$OS" = Darwin ]; then
		curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install
	else
		curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install linux --no-confirm
	fi
fi

# Devbox
if ! command -v devbox >/dev/null 2>&1; then
	curl -fsSL https://get.jetify.com/devbox | bash
fi

# gh extensions (requires gh installed via devbox or brew)
if command -v gh >/dev/null 2>&1; then
	gh extension install github/gh-copilot || true
fi