#!/bin/bash
# Weekly agent-usage report, fired by launchd
# (launchd/com.tyamahori.agent-usage-weekly.plist). Writes the report to
# ~/.local/state/agent-usage/ and posts a macOS notification with the
# omp total / compaction count / churn ratio (--notify).
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
# launchd env has no devbox profile, and uv (agent-usage's shebang) lives
# there; devbox itself is /usr/local/bin on one machine, ~/.nix-profile/bin
# on the other, so resolve it via PATH
eval "$(devbox global shellenv)"

STATE_DIR="$HOME/.local/state/agent-usage"
mkdir -p "$STATE_DIR"

"$HOME/dotfiles/scripts/agent-usage" --days 7 --all --notify \
	>"$STATE_DIR/weekly-$(date +%Y-%m-%d).txt"
