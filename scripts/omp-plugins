#!/bin/bash
set -euo pipefail

# omp (Oh My Pi) plugins — declarative install of pi extensions.
#
# Plugin state (~/.omp/plugins: package.json + node_modules) is machine-local
# and npm-generated, so it is not symlinked like omp/config.yml; this script
# reproduces it instead. Idempotent; safe to re-run.
#
# Selection is voidwarriorchan's pi extension list (2026-08), filtered
# against omp built-ins. Deliberately NOT installed because omp already
# bundles the feature:
#   pi-context-view        -> built-in /context command
#   pi-add-dir             -> built-in /add-dir, /dirs, and /remove-dir commands
#   pi-web-access          -> read(URL) / web_search / GitHub integration
#   pi-session-recall      -> memory + recall tools
#   pi-lens               -> lsp tool
#   pi-vcc                -> snapcompact compaction (tuned in omp/config.yml)
#   pi-undo               -> rewind / checkpoint tools
#   pi-btw                -> /btw
#   pi-transcribe         -> built-in STT (hold Space)
#   pi-codex-image-gen    -> generate_image tool
#   rpiv-ask-user-question -> ask tool
#   pi-review             -> reviewer agent; cross-review goes to Codex anyway

plugins=(
	"@plannotator/pi-extension 0.27.12" # /plannotator-* — annotate plans, messages, code reviews
)

# Retired plugins — uninstall if a machine still carries them.
#   @ff-labs/pi-fff: its dynamic import("@ff-labs/fff-bun") fails inside the
#   Bun-compiled omp binary ("FFF init failed"), leaving the extension dead
#   weight. omp's own fuzzy completion + native grep/glob cover the feature.
retired=(
	pi-context-view
	pi-add-dir
	@ff-labs/pi-fff
)


if ! command -v omp >/dev/null 2>&1; then
	# scripts/apps installs omp from the Brewfile only on macOS, so a missing omp
	# there is a broken setup; Linux has no declared omp install to point at.
	if [ "$(uname)" = Darwin ]; then
		echo "omp-plugins: omp not found; run scripts/apps first (brew: can1357/tap/omp)" >&2
		exit 1
	fi
	echo "omp-plugins: omp not found; skipped (no declared omp install on Linux)" >&2
	exit 0
fi

# `omp`'s worker daemon leaves a stray background process after it runs,
# which breaks any later `<<<` herestring in this script (measured, omp
# 18.2.0: the following heredoc/jq call hangs forever) and its
# `--json` stdout is truncated at 512 bytes when captured through a pipe
# (i.e. via `$(...)`, which `<file` avoids). Route every omp JSON read
# through a temp file and have jq read the file directly — never `<<<` a
# variable populated from omp's output.
omp_plugin_list_json="$(mktemp)"
trap 'rm -f "$omp_plugin_list_json"' EXIT
omp plugin list --json >"$omp_plugin_list_json"

for plugin in "${plugins[@]}"; do
	read -r name version <<<"$plugin"
	installed_version="$(jq -r --arg name "$name" '.npm[] | select(.name == $name) | .version' "$omp_plugin_list_json")"
	if [ "$installed_version" = "$version" ]; then
		echo "omp-plugins: $name@$version already installed" >&2
	elif [ -n "$installed_version" ]; then
		echo "omp-plugins: $name version drift ($installed_version -> $version); reinstalling" >&2
		omp plugin install "$name@$version" --force
	else
		omp plugin install "$name@$version"
	fi
done

# Marketplace plugins (Claude-compatible registry; `omp plugin marketplace`).
# Format: "<plugin-id> <github-repo>".
#   ponytail -> YAGNI ladder injected every turn + /ponytail commands
#               (docs/ponytail.md)
marketplace_plugins=(
	"ponytail@ponytail DietrichGebert/ponytail"
)

for plugin in "${marketplace_plugins[@]}"; do
	read -r id repo <<<"$plugin"
	if jq -e --arg id "$id" 'any(.marketplace[]; .id == $id)' "$omp_plugin_list_json" >/dev/null; then
		echo "omp-plugins: $id already installed" >&2
		continue
	fi
	marketplace="${id##*@}"
	# `marketplace add` fails on a duplicate, so guard with the configured
	# list, read from a temp file (never `<<<`/`$(...)` on omp output —
	# see the truncation/hang notes above).
	omp_marketplace_list="$(mktemp)"
	omp plugin marketplace list >"$omp_marketplace_list" || true
	if ! grep -q "^  $marketplace  " "$omp_marketplace_list"; then
		omp plugin marketplace add "$repo"
	fi
	rm -f "$omp_marketplace_list"
	omp plugin install "$id"
done

for plugin in "${retired[@]}"; do
	if jq -e --arg name "$plugin" 'any(.npm[]; .name == $name)' "$omp_plugin_list_json" >/dev/null; then
		omp plugin uninstall "$plugin"
	fi
done
