#!/bin/bash
set -euo pipefail

# Homebrew bundle. macOS-only: the Brewfile is casks and mas apps, none of
# which exist on Linux. Skipped (not an error) so scripts/setup runs through.
if [ "$(uname)" != "Darwin" ]; then
	echo "apps: skipping brew bundle (macOS only)"
	exit 0
fi

SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"
brew bundle --file "${SCRIPT_DIR}/../dotfiles/.Brewfile"
