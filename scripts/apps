#!/bin/bash
set -euo pipefail

# OS application layer, after scripts/devbox (Linux needs its node).
# macOS: the Brewfile (casks and the claude-code / codex / omp CLIs; mas lines are commented out).
# Linux: those CLIs have no Brewfile, so Claude Code and Docker CE come from
# their apt repos and the rest are installed per user; Copilot CLI comes from
# devbox on both OSes. Versions follow upstream latest.
SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"

if [ "$(uname)" = Darwin ]; then
	brew bundle --file "${SCRIPT_DIR}/../dotfiles/.Brewfile"
	exit 0
fi

# devbox's nodejs lives in the read-only nix store, so global installs go to
# ~/.npm-global (on PATH via .zprofile and scripts/setup).
mkdir -p ~/.npm-global
npm config set prefix ~/.npm-global
npm install -g @openai/codex

# Claude Code from Anthropic's signed apt repo, latest channel to match the
# claude-code@latest cask. nixpkgs trails releases and the read-only store
# blocks self-update; apt verifies the repo signature on every upgrade
# (`sudo apt upgrade claude-code`). The key is checked against the fingerprint
# published at code.claude.com/docs/en/setup before apt trusts it.
claude_list=/etc/apt/sources.list.d/claude-code.list
if [ ! -f "$claude_list" ]; then
	claude_key=/etc/apt/keyrings/claude-code.asc
	sudo install -d -m 0755 /etc/apt/keyrings
	sudo curl -fsSL https://downloads.claude.ai/keys/claude-code.asc -o "$claude_key"
	claude_fpr="$(gpg --show-keys --with-colons "$claude_key" || true)"
	if ! grep -q '^fpr:.*:31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:$' <<<"$claude_fpr"; then
		sudo rm -f "$claude_key"
		echo "apps: Claude Code signing key fingerprint mismatch" >&2
		exit 1
	fi
	echo "deb [signed-by=$claude_key] https://downloads.claude.ai/claude-code/apt/latest latest main" |
		sudo tee "$claude_list" >/dev/null
fi

# Docker CE from Docker's signed apt repo, not the snap: the snap's AppArmor
# profile blocked dockerd's DNS lookups to systemd-resolved (127.0.0.53), so
# every pull failed. Removing the snap purges its images and volumes, so leave
# that call to the user. Key checked against the fingerprint published at
# docs.docker.com/engine/install/ubuntu before apt trusts it.
if snap list docker >/dev/null 2>&1; then
	echo "apps: snap docker is installed; remove it first (drops its images and volumes): sudo snap remove --purge docker" >&2
	exit 1
fi
docker_sources=/etc/apt/sources.list.d/docker.sources
# docker.list: OrbStack VMs built before Docker moved here from cloud-init
if [ ! -f "$docker_sources" ] && [ ! -f /etc/apt/sources.list.d/docker.list ]; then
	docker_key=/etc/apt/keyrings/docker.asc
	sudo install -d -m 0755 /etc/apt/keyrings
	sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o "$docker_key"
	docker_fpr="$(gpg --show-keys --with-colons "$docker_key" || true)"
	if ! grep -q '^fpr:.*:9DC858229FC7DD38854AE2D88D81803C0EBFCD88:$' <<<"$docker_fpr"; then
		sudo rm -f "$docker_key"
		echo "apps: Docker signing key fingerprint mismatch" >&2
		exit 1
	fi
	# shellcheck source=/dev/null
	sudo tee "$docker_sources" >/dev/null <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Signed-By: $docker_key
EOF
fi
# ghostty from the Ubuntu archive: it links the host mesa, so it renders
# without the LD_LIBRARY_PATH wrapper nixpkgs' build needed (which leaked into
# every shell and broke nix binaries once nixpkgs' glibc outran the host's).
# The archive ships it from 26.04; older releases such as the 24.04 OrbStack
# VM (headless anyway) have no candidate, which would fail the whole install.
pkgs=(claude-code docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)
if [ -n "$(apt-cache search --names-only '^ghostty$')" ]; then
	pkgs+=(ghostty)
fi
missing=()
for pkg in "${pkgs[@]}"; do
	dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
# Update here, not when a list is added: a failed update after writing the
# list would leave the rerun skipping it and failing on "Unable to locate package".
if [ ${#missing[@]} -gt 0 ]; then
	sudo apt-get update
	sudo apt-get install -y "${missing[@]}"
fi
if ! systemctl is-enabled --quiet docker || ! systemctl is-active --quiet docker; then
	sudo systemctl enable --now docker
fi
# Group membership applies from the next login (or `newgrp docker`).
user="${USER:-$(id -un)}"
if ! id -nG "$user" | grep -qw docker; then
	sudo usermod -aG docker "$user"
fi

# OMP's only Linux layer is the upstream binary in ~/.local/bin, updated by
# `omp update` (scripts/brewUpdate). npm/bun global copies of the same package
# sit earlier on PATH (.zprofile puts ~/.npm-global/bin first) and silently
# shadow it with a stale version, so drop them.
if npm ls -g --depth=0 @oh-my-pi/pi-coding-agent >/dev/null 2>&1; then
	npm uninstall -g @oh-my-pi/pi-coding-agent
fi
if command -v bun >/dev/null 2>&1 && [ -e "$HOME/.bun/bin/omp" ]; then
	bun remove -g @oh-my-pi/pi-coding-agent
fi

# --binary: the installer's bun route needs a newer bun than the devbox pin.
# Download first so a failed fetch fails this step instead of piping nothing
# into sh.
if [ ! -x "$HOME/.local/bin/omp" ]; then
	installer="$(mktemp)"
	trap 'rm -f "$installer"' EXIT
	curl -fsSL https://omp.sh/install -o "$installer"
	sh "$installer" --binary
fi

# ax (web fetch CLI the shared agent instructions call) is a Homebrew tap on
# macOS and absent from nixpkgs, so Linux takes the upstream release binary.
if ! command -v ax >/dev/null 2>&1; then
	case "$(uname -m)" in
	x86_64) ax_arch=x64 ;;
	aarch64 | arm64) ax_arch=arm64 ;;
	*)
		echo "apps: no ax binary for $(uname -m)" >&2
		exit 1
		;;
	esac
	mkdir -p ~/.local/bin
	curl -fsSL "https://github.com/yusukebe/ax/releases/latest/download/ax-linux-${ax_arch}" -o ~/.local/bin/ax
	chmod +x ~/.local/bin/ax
fi
