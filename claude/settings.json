{
  "cleanupPeriodDays": 365,
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "phpstorm-plugin@phpstorm-marketplace": true,
    "plannotator@plannotator": true,
    "ponytail@ponytail": true,
    "reviewable-html-workbench@reviewable-html-workbench-local": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      }
    },
    "phpstorm-marketplace": {
      "source": {
        "repo": "jetbrains/phpstorm-claude-marketplace",
        "source": "github"
      }
    },
    "plannotator": {
      "source": {
        "repo": "backnotprop/plannotator",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "reviewable-html-workbench-local": {
      "source": {
        "repo": "u-ichi/reviewable-html-workbench",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/lint-on-edit\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/japanese-prose-hook-edit\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/worktree-copy-hook\"",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/push-agent-hint\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/push-agent-hint\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/deny-bare-python-hook\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/deny-shell-read-search.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/japanese-prose-hook-edit\"",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-subagents.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/jbcontext-clobber-check\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/claude/hooks/session-hygiene.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/japanese-prose-hook-stop\"",
            "timeout": 120,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-subagents.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-subagents.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/herdr-title\" claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "claude-fable-5",
  "permissions": {
    "allow": [
      "Bash(herdr *)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(command -v *)",
      "Bash(diff *)",
      "Bash(dscacheutil -q host -a name *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(shellcheck *)",
      "Bash(uv run *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-tree *)",
      "Bash(git merge --ff-only *)",
      "Bash(git merge-base *)",
      "Bash(git pull *)",
      "Bash(git push origin *)",
      "Bash(git remote *)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(git switch *)",
      "Bash(git worktree list)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git -C /private/tmp/*)",
      "Bash(GIT_EDITOR=true git rebase --continue)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh run *)",
      "Bash(claude mcp *)",
      "Bash(codex exec *)",
      "Bash(docker compose *)",
      "Bash(docker context *)",
      "Bash(docker exec *)",
      "Bash(docker info *)",
      "Bash(docker restart *)",
      "Bash(docker volume *)",
      "Read(~/.config/**)",
      "Read(~/.agents/skills/**)",
      "Read(~/dotfiles/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:devblogs.microsoft.com)",
      "Skill(artifact-design)",
      "Skill(update-config)",
      "mcp__claude-in-chrome__tabs_context_mcp"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "freee-api-skill": "off",
    "update-config": "user-invocable-only"
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "npx -y ccusage statusline",
    "padding": 0,
    "type": "command"
  },
  "switchModelsOnFlag": false
}
