{
  "cleanupPeriodDays": 365,
  "effortLevel": "high",
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "phpstorm-plugin@phpstorm-marketplace": true,
    "plannotator@plannotator": true,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "reviewable-html-workbench@reviewable-html-workbench-local": true,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      }
    },
    "phpstorm-marketplace": {
      "source": {
        "repo": "jetbrains/phpstorm-claude-marketplace",
        "source": "github"
      }
    },
    "plannotator": {
      "source": {
        "repo": "backnotprop/plannotator",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "reviewable-html-workbench-local": {
      "source": {
        "repo": "u-ichi/reviewable-html-workbench",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/lint-on-edit\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/japanese-prose-hook-edit\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/worktree-copy-hook\"",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/push-agent-hint\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/fail-fast-hook\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/push-agent-hint\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/fail-fast-hook\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/dotfiles/scripts/deny-command-hook.ts\" claude",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/japanese-prose-hook-edit\"",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/dotfiles/scripts/deny-command-hook.ts\" claude",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*[Ss]lack.*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-subagents.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/jbcontext-clobber-check\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/session-hygiene-hook\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/agents-local-context\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/japanese-prose-hook-stop\"",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-subagents.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-subagents.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/herdr-title\" claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "claude-fable-5-2",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "allow": [
      "Bash(herdr *)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(command -v *)",
      "Bash(diff *)",
      "Bash(dscacheutil -q host -a name *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(shellcheck *)",
      "Bash(uv run *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-tree *)",
      "Bash(git merge --ff-only *)",
      "Bash(git merge-base *)",
      "Bash(git pull *)",
      "Bash(git remote *)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git stash show *)",
      "Bash(git status *)",
      "Bash(git switch *)",
      "Bash(git worktree list)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh run *)",
      "Bash(claude mcp *)",
      "Bash(codex exec *)",
      "Bash(docker compose *)",
      "Bash(docker context *)",
      "Bash(docker exec *)",
      "Bash(docker info *)",
      "Bash(docker restart *)",
      "Bash(docker volume *)",
      "Read(~/.config/**)",
      "Read(~/.agents/skills/**)",
      "Read(~/dotfiles/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:devblogs.microsoft.com)",
      "Skill(artifact-design)",
      "mcp__claude-in-chrome__tabs_context_mcp"
    ],
    "ask": [
      "Bash(docker volume prune*)",
      "Bash(docker volume rm *)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh repo archive *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(git * push *--force*)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout .)",
      "Bash(git clean *-*f*)",
      "Bash(git push * +*)",
      "Bash(git push * -f*)",
      "Bash(git reset *--hard*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f*)"
    ],
    "blockWritesOutsideWorkingDirectories": true,
    "defaultMode": "auto",
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(op *)",
      "Read(//**/*.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "enabled": true,
    "excludedCommands": [
      "docker *",
      "gh *",
      "git fetch *",
      "git pull *",
      "git push *",
      "make *"
    ],
    "filesystem": {
      "denyRead": [
        "~/**/.env",
        "~/**/.env.local"
      ]
    }
  },
  "skillListingBudgetFraction": 0.03125,
  "skillOverrides": {
    "freee-api-skill": "off",
    "update-config": "user-invocable-only"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "\"$HOME/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/ccusage\" statusline",
    "padding": 0,
    "type": "command"
  },
  "switchModelsOnFlag": false,
  "theme": "dark",
  "tui": "fullscreen"
}
