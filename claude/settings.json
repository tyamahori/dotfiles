{
  "model": "opus[1m]",
  "switchModelsOnFlag": false,
  "cleanupPeriodDays": 365,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(herdr *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/claude/hooks/deny-bare-python.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/kazuki.tamahori/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccusage statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "phpstorm-plugin@phpstorm-marketplace": true,
    "warp@claude-code-warp": true,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "phpstorm-marketplace": {
      "source": {
        "source": "github",
        "repo": "jetbrains/phpstorm-claude-marketplace"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "skipAutoPermissionPrompt": true,
  "skillOverrides": {
    "freee-api-skill": "off",
    "japanese-tech-writing": "off",
    "orbstack-dev": "off"
  }
}
