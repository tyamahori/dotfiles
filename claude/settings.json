{
    "cleanupPeriodDays": 365,
    "permissions": {
        "allow": [
            "Bash(herdr *)",
            "Bash(awk *)",
            "Bash(cat *)",
            "Bash(cd *)",
            "Bash(chmod +x *)",
            "Bash(command -v *)",
            "Bash(diff *)",
            "Bash(dscacheutil -q host -a name *)",
            "Bash(echo *)",
            "Bash(env)",
            "Bash(jq *)",
            "Bash(shellcheck *)",
            "Bash(uv run *)",
            "Bash(git add *)",
            "Bash(git branch *)",
            "Bash(git check-ignore *)",
            "Bash(git checkout *)",
            "Bash(git commit *)",
            "Bash(git diff *)",
            "Bash(git fetch *)",
            "Bash(git log *)",
            "Bash(git ls-remote *)",
            "Bash(git ls-tree *)",
            "Bash(git merge --ff-only *)",
            "Bash(git merge-base *)",
            "Bash(git pull *)",
            "Bash(git push origin *)",
            "Bash(git remote *)",
            "Bash(git rev-list *)",
            "Bash(git rev-parse *)",
            "Bash(git show *)",
            "Bash(git stash *)",
            "Bash(git status *)",
            "Bash(git switch *)",
            "Bash(git worktree list)",
            "Bash(git worktree add *)",
            "Bash(git worktree remove *)",
            "Bash(git -C /private/tmp/*)",
            "Bash(GIT_EDITOR=true git rebase --continue)",
            "Bash(gh api *)",
            "Bash(gh issue *)",
            "Bash(gh label *)",
            "Bash(gh pr *)",
            "Bash(gh repo *)",
            "Bash(gh run *)",
            "Bash(claude mcp *)",
            "Bash(codex exec *)",
            "Bash(docker compose *)",
            "Bash(docker context *)",
            "Bash(docker exec *)",
            "Bash(docker info *)",
            "Bash(docker restart *)",
            "Bash(docker volume *)",
            "Bash(bash ~/.agents/skills/agmsg/scripts/*)",
            "Bash(~/.agents/skills/agmsg/scripts/*)",
            "Bash(~/dotfiles/scripts/agmsg-pair)",
            "Bash(~/dotfiles/scripts/herdr-spawn-pane *)",
            "Read(~/.config/**)",
            "Read(~/.agents/skills/**)",
            "Read(~/projects/dotfiles/**)",
            "WebSearch",
            "WebFetch(domain:github.com)",
            "WebFetch(domain:claude.ai)",
            "WebFetch(domain:pnpm.io)",
            "WebFetch(domain:qiita.com)",
            "WebFetch(domain:devblogs.microsoft.com)",
            "Skill(artifact-design)",
            "Skill(update-config)",
            "mcp__claude-in-chrome__tabs_context_mcp"
        ],
        "defaultMode": "auto"
    },
    "model": "claude-fable-5",
    "skillOverrides": {
        "freee-api-skill": "off",
        "japanese-tech-writing": "off",
        "orbstack-dev": "off"
    },
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME/dotfiles/scripts/herdr-title\" claude",
                        "timeout": 10
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
                        "timeout": 10
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "StopFailure": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME/dotfiles/claude/hooks/deny-bare-python.sh\"",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME/dotfiles/claude/hooks/herdr-notify.sh\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "TeammateIdle": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME/.jbcontext/bin/jbcontext_binary\" index --silent",
                        "async": true
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$HOME/.jbcontext/bin/jbcontext_binary\" index --silent",
                        "async": true
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "npx -y ccusage statusline",
        "padding": 0
    },
    "enabledPlugins": {
        "phpstorm-plugin@phpstorm-marketplace": true,
        "warp@claude-code-warp": true,
        "claude-md-management@claude-plugins-official": true,
        "reviewable-html-workbench@reviewable-html-workbench-local": true
    },
    "extraKnownMarketplaces": {
        "phpstorm-marketplace": {
            "source": {
                "source": "github",
                "repo": "jetbrains/phpstorm-claude-marketplace"
            }
        },
        "claude-code-warp": {
            "source": {
                "source": "github",
                "repo": "warpdotdev/claude-code-warp"
            }
        },
        "reviewable-html-workbench-local": {
            "source": {
                "source": "github",
                "repo": "u-ichi/reviewable-html-workbench"
            }
        }
    },
    "switchModelsOnFlag": false,
    "skipAutoPermissionPrompt": true
}
