{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "!**/node_modules",
      "!omp/extensions/herdr-omp-agent-state.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
