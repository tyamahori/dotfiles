# Linked to ~/.homebrew/brew.env by scripts/link. brew reads this file itself,
# so non-interactive and agent shells get the same settings as zsh.
# No shell expansion or quoting: values are taken literally.
HOMEBREW_NO_ASK=1
# devbox/devbox.json owns these CLIs (README "Package layering"). go, bun,
# cmake and node stay allowed: Brewfile formulae depend on them.
HOMEBREW_FORBIDDEN_FORMULAE=go-task pnpm direnv git-lfs uv ccusage gopls pyright terraform-ls gh awscli semgrep ruff actionlint gitleaks oxlint delve git-absorb hyperfine bash-language-server yaml-language-server xh fzf zoxide bat starship hadolint shellcheck carapace mas php
HOMEBREW_FORBIDDEN_OWNER=dotfiles devbox/devbox.json
