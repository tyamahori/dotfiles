{
  "description": "Notify when Codex is waiting for user approval, and title the herdr pane with the submitted prompt.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/codex-notify permission-request",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/herdr-title\" codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
