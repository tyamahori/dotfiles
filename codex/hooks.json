{
  "description": "Block bare Python, notify on approval, title Herdr panes, review edited Japanese prose, shellcheck edited shell scripts, detect jbcontext clobbers, sweep worktree includes, and hint on locked-1Password SSH failures.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/codex-notify permission-request",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/deny-bare-python-hook\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/codex/hooks/japanese-prose-edit.sh\"",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/codex/hooks/japanese-prose-edit.sh\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/codex/hooks/shellcheck-edit.sh\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/worktree-copy-hook\"",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/push-agent-hint\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "JAPANESE_PROSE_RUNTIME=codex \"$HOME/dotfiles/scripts/japanese-prose-hook-stop\"",
            "timeout": 120,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/plannotator",
            "timeout": 345600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/dotfiles/scripts/jbcontext-clobber-check\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/herdr-title\" codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
