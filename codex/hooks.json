{
  "description": "Notify when Codex is waiting for user approval.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/codex-notify permission-request",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/tyamahori/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}