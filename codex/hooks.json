{
  "description": "Notify on approval, title Herdr panes, and review edited Japanese prose.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/codex-notify permission-request",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/codex/hooks/japanese-prose-edit.sh\"",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/codex/hooks/japanese-prose-edit.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "JAPANESE_PROSE_RUNTIME=codex \"$HOME/dotfiles/scripts/japanese-prose-hook-stop\"",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/dotfiles/scripts/herdr-title\" codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
